# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/miladwani?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"
NEXTAUTH_URL="https://devmiladwani.agtci.com"

# Account verification.
#   false (current) — plain email-or-mobile + password. New accounts are
#                     active immediately; no OTP. Use this while testing.
#   true            — registration issues an OTP, new accounts start PENDING
#                     and cannot sign in until verified. Needs a working SMTP
#                     (and, for mobile OTP, an SMS provider) to be usable.
NEXT_PUBLIC_AUTH_REQUIRE_VERIFICATION=false

# App
NEXT_PUBLIC_APP_URL="https://devmiladwani.agtci.com"
NEXT_PUBLIC_APP_NAME="Mi Ladwani"
NEXT_PUBLIC_COMMUNITY_NAME="Ladwani Samaj"

# File Storage (S3 compatible)
S3_BUCKET_NAME="miladwani-uploads"
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@miladwani.com"

# Redis (optional - for rate limiting)
REDIS_URL="redis://localhost:6379"

# Admin
ADMIN_EMAIL="admin@miladwani.com"
ADMIN_PASSWORD="ChangeThisInProduction123!"
