# Database — PostgreSQL. Every tier runs on Neon: one Neon branch per tier
# (production, test, dev), each with the database "ladwani" owned by the role
# "bk_ladwani_app". Copy both strings from the Neon console: the branch ->
# Connect -> database ladwani, role bk_ladwani_app, then
#   "Connection pooling" ON  -> DATABASE_URL           (host has "-pooler")
#   "Connection pooling" OFF -> DATABASE_URL_UNPOOLED  (the direct endpoint)
# The app uses the pooled one. Prisma's CLI (migrate deploy, migrate status,
# studio) uses the direct one, because migrate holds a session-level advisory
# lock that a transaction-mode pooler cannot keep. Keep Neon's
# ?sslmode=require&channel_binding=require on both. Don't add pgbouncer=true:
# Neon's PgBouncer supports the prepared statements Prisma uses.
#
# Locally, or anywhere with a single database, DATABASE_URL is enough: leave
# DATABASE_URL_UNPOOLED as "${DATABASE_URL}" (Prisma and Next expand it) or
# unset it (scripts/with-env.js fills it in). `docker compose up postgres`
# matches the URL below. The schema needs the citext and btree_gist
# extensions; the first migration creates them, and on Neon the database
# owner may (it is a member of neon_superuser).
DATABASE_URL="postgresql://postgres:password@localhost:5432/miladwani?schema=public"
DATABASE_URL_UNPOOLED="${DATABASE_URL}"
# On Neon (placeholders, never commit real ones):
# DATABASE_URL="postgresql://bk_ladwani_app:<password>@<endpoint>-pooler.<region>.aws.neon.tech/bk_ladwani?sslmode=require&channel_binding=require"
# DATABASE_URL_UNPOOLED="postgresql://bk_ladwani_app:<password>@<endpoint>.<region>.aws.neon.tech/bk_ladwani?sslmode=require&channel_binding=require"

# NextAuth. NEXTAUTH_URL is either the site's origin or the full URL of this
# app's auth API. Under BASE_PATH=/ladwani on bkesari.com that is
# https://bkesari.com/ladwani/api/auth. Never just ".../ladwani": next-auth's
# middleware then treats every page as part of its own API and stops
# protecting them (next.config.js refuses to start with that).
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Account verification.
#   false (current) — plain email-or-mobile + password. New accounts are
#                     active immediately; no OTP. Use this while testing.
#   true            — registration issues an OTP, new accounts start PENDING
#                     and cannot sign in until verified. Needs a working SMTP
#                     (and, for mobile OTP, an SMS provider) to be usable.
NEXT_PUBLIC_AUTH_REQUIRE_VERIFICATION=false

# The path prefix this app is served under. The hub at bkesari.com forwards
# /ladwani/ here WITHOUT stripping the prefix, so the app has to own it.
#
# Set it in TWO places or the app breaks in a way that still returns HTTP 200:
#   - here, because `next start` reads next.config.js again to decide routing;
#   - in the build, which the deploy workflow does, because Next inlines the
#     value into the client bundles.
# A build made with it but started without it serves the app at the root while
# every asset and API URL in its HTML points at /ladwani/.
#
# Leave blank only when this app is served from the root of its own hostname.
BASE_PATH=/ladwani

# App. NEXT_PUBLIC_APP_URL is the public URL of this app, prefix included
# (https://bkesari.com/ladwani); invitation emails link to it.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Mi Ladwani"
NEXT_PUBLIC_COMMUNITY_NAME="Ladwani Samaj"

# File Storage (S3 compatible)
S3_BUCKET_NAME="miladwani-uploads"
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# Email (SMTP) — see SMTP-SETUP.md for the Hostinger walkthrough.
# Test with: npm run test:smtp -- you@example.com
# SMTP_USER must be the full email address; SMTP_FROM should match it.
# Port 465 = SSL/TLS, port 587 = STARTTLS (derived from the port automatically).
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Redis (optional - for rate limiting)
REDIS_URL="redis://localhost:6379"

# Admin — the single login `npm run db:seed` creates. Change the password
# immediately after the first production login.
ADMIN_EMAIL="admin@miladwani.com"
ADMIN_PASSWORD="ChangeThisInProduction123!"

# Seed the fake test accounts (test.member@example.test etc., all sharing the
# password TestPass@123)? Leave UNSET on production — they are dev/test only.
# SEED_TEST_ACCOUNTS=true

# ── Photo storage ────────────────────────────────────────────────
# LOCAL — files under UPLOAD_DIR (default ./uploads). Needs nothing else,
#         and works on shared hosting. This is the default.
# S3    — any S3-compatible bucket (AWS, Cloudflare R2, MinIO).
# Left unset, S3 is used when fully configured, otherwise LOCAL.
STORAGE_DRIVER=LOCAL
UPLOAD_DIR=./uploads

# ── Payments ─────────────────────────────────────────────────────
# MOCK runs the full booking/fee flow without live credentials, still
# signing and verifying like a real gateway. Set a real provider when ready.
PAYMENT_GATEWAY=MOCK
PAYMENT_SIGNING_SECRET=""

# ── SMS (P0 notification service) ────────────────────────────────
# LOG — messages are written to the server log and recorded as NOT sent.
# A real gateway needs DLT-registered templates first (Open Point OP-10).
SMS_DRIVER=LOG

# ── P1 verification ──────────────────────────────────────────────
# Admin accounts sign in with password + an emailed 6-digit code (F32).
# Set to false ONLY on a local machine with no mail at all.
AUTH_ADMIN_2FA=true
# Mobile number mandatory at sign-up (workbook F01; owner's decision). On when
# unset; set to false only to make it optional again. Rebuild after changing
# (NEXT_PUBLIC_). Existing accounts without a mobile are not affected.
NEXT_PUBLIC_REGISTRATION_REQUIRE_MOBILE=true
# ID proofs are AES-256-GCM encrypted at rest. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe and never change it once proofs exist (they could not be read).
ID_PROOF_KEY=""
# Shared secret for the hosting cron jobs:
#   hourly — overdue approvals (F06):
#   curl -fsS -H "x-cron-secret: $CRON_SECRET" https://<site>/api/cron/approval-sla
#   daily — join-request expiry (F15) and Karta-vacancy alerts (F16):
#   curl -fsS -H "x-cron-secret: $CRON_SECRET" https://<site>/api/cron/daily
#
# ── Interest-group daily digest ──────────────────────────────────
# Secret for the daily cron call to POST /api/cron/group-digest (header
# x-cron-secret). The endpoint refuses to run while this is empty.
CRON_SECRET=""
