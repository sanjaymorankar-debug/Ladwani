# PostgreSQL. On Neon: DATABASE_URL is the pooled endpoint (host has -pooler),
# DATABASE_URL_UNPOOLED the direct one, which Prisma Migrate uses. Locally,
# set both to the same URL. The API adds max_idle_connection_lifetime=30 and
# connect_timeout=15 to DATABASE_URL unless it sets them (prisma.service.ts).
DATABASE_URL="postgresql://user:password@localhost:5432/community_platform_dev"
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/community_platform_dev"
JWT_SECRET="change-me-to-a-strong-random-value"
WEB_ORIGIN="http://localhost:3000"
PORT=4000
NODE_ENV="development"
# Behind a proxy (Hostinger), the addresses of our own hops, so rate limits
# count per visitor: "loopback, <the server's IP>". Unset trusts nothing, and
# every visitor then shares one budget. See src/common/trust-proxy.ts.
# TRUST_PROXY="loopback"
