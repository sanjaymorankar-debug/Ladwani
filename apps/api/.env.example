# PostgreSQL. On Neon: DATABASE_URL is the pooled endpoint (host has -pooler),
# DATABASE_URL_UNPOOLED the direct one, which Prisma Migrate uses. Locally,
# set both to the same URL.
DATABASE_URL="postgresql://user:password@localhost:5432/community_platform_dev"
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/community_platform_dev"
JWT_SECRET="change-me-to-a-strong-random-value"
WEB_ORIGIN="http://localhost:3000"
PORT=4000
NODE_ENV="development"
