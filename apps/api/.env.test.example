# Copy to apps/api/.env.test (gitignored) for local integration testing.
#
#   npm run test:local        # from the repo root — migrates, then runs it
#
# This file is ONLY for the integration suite. The default `npm test` is 23
# mocked unit suites that read no environment at all, so you do not need
# this file to run them.

# Must be a THROWAWAY database. The integration suite creates and deletes
# real users, assets and bookings, so never point this at your dev database
# or at anything you care about.
#
# A local PostgreSQL, e.g. `createdb ladwani_rebuild_test`. Never Neon: tests
# only ever run against a throwaway local database. Both variables are the
# same URL here; Prisma Migrate reads the second.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/ladwani_rebuild_test"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@127.0.0.1:5432/ladwani_rebuild_test"

# Not currently read by the integration suite (it constructs services
# directly and never builds the JWT module), but kept for parity with
# .env.example so this file also works for a locally served API.
JWT_SECRET="test-only-not-a-real-secret"
WEB_ORIGIN="http://localhost:3000"
PORT=4000
NODE_ENV="test"
