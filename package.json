{
  "name": "miladwani",
  "version": "1.0.0",
  "private": true,
  "description": "Mi Ladwani — Community Family Registry, Directory & Matrimony Platform",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "ts-node --project prisma/seeds/tsconfig.seed.json prisma/seeds/seed.ts",
    "db:seed:uat": "ts-node --project prisma/seeds/tsconfig.seed.json prisma/seeds/uat-seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "test": "node scripts/with-env.js .env.test npx vitest run",
    "test:migrate": "node scripts/with-env.js .env.test npx prisma migrate deploy",
    "migrate:mysql-to-postgres": "ts-node --project prisma/seeds/tsconfig.seed.json scripts/migrate-mysql-to-postgres.ts",
    "test:smtp": "node scripts/with-env.js .env node scripts/test-smtp.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.624.0",
    "@aws-sdk/s3-request-presigner": "^3.624.0",
    "@hookform/resolvers": "^5.9.2",
    "@prisma/client": "^5.16.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.2",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.416.0",
    "next": "15.5.28",
    "next-auth": "^4.24.7",
    "nodemailer": "^10.2.1",
    "prisma": "^5.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-hot-toast": "^2.4.1",
    "react-leaflet": "^5.0.0",
    "reactflow": "^11.11.4",
    "recharts": "^2.12.7",
    "sharp": "^0.35.5",
    "tailwind-merge": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.28",
    "mysql2": "^3.24.2",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "vitest": "^4.1.11"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    },
    "next": {
      "postcss": "$postcss"
    }
  }
}
