generator client {
  provider = "prisma-client-js"
}

// Two URLs, the names Neon's own tooling writes:
// - DATABASE_URL           the app at runtime. On Neon, the *pooled* endpoint
//                          (host contains "-pooler"; PgBouncer, transaction mode).
// - DATABASE_URL_UNPOOLED  the CLI: migrate, db push, studio. On Neon, the
//                          *direct* endpoint, because migrate takes a
//                          session-level advisory lock the pooler cannot hold.
// The app at runtime never reads DATABASE_URL_UNPOOLED, but every CLI command
// that loads this datasource fails while it is unset. Prisma has no fallback
// of its own, so with only one database (local, CI) both hold the same URL:
// scripts/with-env.js copies DATABASE_URL into it when it is unset, and
// .env.example sets it to "${DATABASE_URL}", which Prisma's .env loader expands.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// PostgreSQL notes (the database was MySQL until Oct 2026):
// - users.email is CITEXT, so the unique index and every lookup are
//   case-insensitive, as they were under MySQL's utf8mb4_unicode_ci. The
//   baseline migration runs CREATE EXTENSION citext.
// - bookings carries an exclusion constraint (bookings_no_overlap, btree_gist)
//   that Prisma cannot express; it lives only in the migration SQL. See the
//   comment on model Booking.
// - Free-text search uses `mode: 'insensitive'` (ILIKE), since Postgres
//   compares text case-sensitively by default.

// ─────────────────────────────────────────────────────────────────
// AUTHENTICATION & ROLES
// ─────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String?   @unique @db.Citext
  mobile          String?   @unique
  passwordHash    String
  emailVerified   Boolean   @default(false)
  mobileVerified  Boolean   @default(false)
  status          UserStatus @default(PENDING)
  // What the user chose at signup: KARTA (register a new family and head it)
  // or JOIN_EXISTING (find and join a family already on the platform).
  // This records INTENT only — it never grants a role by itself. The KARTA
  // role is granted server-side when a family is actually created.
  joinIntent              String?
  lastLoginAt             DateTime?
  lastLoginIp             String?
  failedAttempts          Int        @default(0)
  lockedUntil             DateTime?
  // P1 registration approval (F03–F06). The combined reason shown to the
  // user never names the operators who decided.
  registrationSubmittedAt DateTime?
  registrationDecidedAt   DateTime?
  registrationNote        String?    @db.Text
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt
  deletedAt               DateTime?

  member                  Member?
  userRoles               UserRole[]
  refreshTokens           RefreshToken[]
  verificationTokens      VerificationToken[]
  consentRecords          ConsentRecord[]
  posts                   Post[]
  comments                Comment[]
  reactions               Reaction[]
  reports                 Report[]
  sentNotifications       Notification[]         @relation("NotificationSender")
  receivedNotifications   Notification[]         @relation("NotificationRecipient")
  approvalSubmissions     Approval[]             @relation("ApprovalSubmitter")
  approvalReviews         Approval[]             @relation("ApprovalReviewer")
  auditLogs               AuditLog[]
  blockedBy               BlockedUser[]          @relation("Blocker")
  blocking                BlockedUser[]          @relation("Blocked")
  uploadedPhotos          Photo[]
  idProofs                IdProof[]
  approvalTasksAsSubject  ApprovalTask[]         @relation("TaskSubject")
  approvalTasksAsOperator ApprovalTask[]         @relation("TaskOperator")
  profileChangeRequests   ProfileChangeRequest[]

  @@map("users")
}

// Workbook "Status & Alerts" mapping (existing names kept):
//   DRAFT = DRAFT, PENDING_APPROVAL = PENDING_APPROVAL, ACTIVE = ACTIVE,
//   CORRECTION_REQUIRED, REJECTED, SUSPENDED as named. PENDING keeps its
//   existing meaning: email not yet verified (sign-in refused when
//   verification is on). EXPIRED (deceased) lives on members.status = DECEASED.
enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BLOCKED
  DEACTIVATED
  DRAFT
  PENDING_APPROVAL
  CORRECTION_REQUIRED
  REJECTED
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique // MEMBER, KARTA, OPERATOR, ADMIN
  label       String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id     String @id @default(cuid())
  code   String @unique // e.g. family:create, member:mark_deceased
  label  String
  module String // family, member, matrimony, etc.

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String    @id @default(cuid())
  userId     String
  roleId     String
  familyId   String? // scoped Karta role
  areaId     String? // scoped role: OPERATOR / DISTRICT_TEAM -> a DISTRICT area, STATE_TEAM -> a STATE area (src/lib/scope.ts)
  grantedBy  String?
  grantedAt  DateTime  @default(now())
  expiresAt  DateTime?
  /// F30 / F31: a data-view role that comes from a seat on a LadWani body;
  /// removed automatically when the seat ends.
  bodySeatId String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id])
  family Family? @relation(fields: [familyId], references: [id])
  area   Area?   @relation(fields: [areaId], references: [id])

  @@map("user_roles")
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  type      String // EMAIL_VERIFY, MOBILE_VERIFY, PASSWORD_RESET, ADMIN_2FA, DECLARATION
  tokenHash String
  attempts  Int       @default(0) // wrong guesses; the code is burned at 5 (src/lib/otp.ts)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("verification_tokens")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  deviceInfo Json?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model ConsentRecord {
  id              String    @id @default(cuid())
  userId          String
  consentType     String // PROFILE_STORAGE, FAMILY_INFO, PHOTO_UPLOAD, MATRIMONIAL_VISIBILITY, NOTIFICATIONS
  granted         Boolean
  version         String?
  ipAddress       String?
  userAgent       String?
  // F03 declaration consent: the exact text agreed to and the OTP that confirmed it.
  declarationText String?   @db.Text
  otpReference    String?
  grantedAt       DateTime  @default(now())
  revokedAt       DateTime?
  /// Whose data the consent covers when it isn't the signed-in user's own —
  /// a Karta or parent consenting for a child or an account-less elder.
  memberId        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([memberId, consentType])
  @@map("consent_records")
}

// ─────────────────────────────────────────────────────────────────
// FAMILY
// ─────────────────────────────────────────────────────────────────

model Family {
  id                    String             @id @default(cuid())
  registrationNumber    String             @unique
  name                  String
  surname               String?
  description           String?            @db.Text
  kuladevata            String?
  kuladevi              String?
  gotra                 String?
  traditionalOccupation String?
  nativeVillage         String?
  nativeDistrict        String?
  nativeState           String?
  nativeCountry         String             @default("India")
  kartaMemberId         String?
  familyPhotoId         String?
  status                FamilyStatus       @default(PENDING)
  verificationStatus    VerificationStatus @default(UNVERIFIED)
  verifiedBy            String?
  verifiedAt            DateTime?
  communityId           String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  createdBy             String?
  updatedBy             String?
  deletedAt             DateTime?

  members      FamilyMember[]
  addresses    Address[]
  familyAreas  FamilyArea[]
  userRoles    UserRole[]
  photos       Photo[]
  joinRequests FamilyJoinRequest[]
  feeInvoices  FeeInvoice[]
  karta        Member?             @relation("FamilyKarta", fields: [kartaMemberId], references: [id])

  @@map("families")
}

// Workbook "Family" statuses: ACTIVE, KARTA_VACANT (F16), MERGED; CLOSED = ARCHIVED.
enum FamilyStatus {
  PENDING
  ACTIVE
  INACTIVE
  MERGED
  ARCHIVED
  KARTA_VACANT
}

enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

model FamilyJoinRequest {
  id                   String    @id @default(cuid())
  familyId             String
  memberId             String
  relatedToMemberId    String?
  relationshipTypeCode String?
  /// Who asked whom — the two directions have opposite approvers:
  ///   MEMBER_REQUEST — a person asks to join a family; its Karta decides.
  ///   KARTA_INVITE   — a Karta asks an already-registered person to join
  ///                    their family; that person decides (§11, §49). A Karta
  ///                    can never add an existing account-holder unilaterally.
  direction            String    @default("MEMBER_REQUEST")
  /// MEMBER (a person asked) or MARRIAGE (F23: created when a spouse is linked).
  origin               String    @default("MEMBER")
  requestedBy          String
  status               String    @default("PENDING") // PENDING, APPROVED, REJECTED
  respondedBy          String?
  respondedAt          DateTime?
  responseNote         String?
  createdAt            DateTime  @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // F14: one OPEN request per person per family is enforced in code; the old
  // unique(familyId, memberId, status, direction) also blocked a second
  // REJECTED row, so a re-request could never be rejected again.
  @@index([familyId, memberId, status])
  @@map("family_join_requests")
}

/// Invites a real person to claim a Member profile somebody else created for
/// them — a Karta adding an elderly parent or a child, who later gets their
/// own login (§12, §34). Until the invitation is accepted the profile has no
/// `Member.userId` and the Karta maintains it; accepting creates the User,
/// links it, and hands control of the profile to that person.
model MemberInvitation {
  id         String    @id @default(cuid())
  memberId   String
  email      String?
  mobile     String?
  /// SHA-256 of the emailed token. The raw token is sent once and never
  /// stored, so read access to this table can't be used to claim a profile.
  tokenHash  String    @unique
  status     String    @default("PENDING") // PENDING, ACCEPTED, REVOKED
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  acceptedBy String?
  revokedAt  DateTime?
  revokedBy  String?
  createdAt  DateTime  @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, status])
  @@map("member_invitations")
}

model FamilyMember {
  id                 String    @id @default(cuid())
  familyId           String
  memberId           String
  isKarta            Boolean   @default(false)
  joinedAt           DateTime  @default(now())
  joinedBy           String?
  leftAt             DateTime?
  leftReason         String? // MARRIED_OUT, DECEASED, SEPARATED, ERROR, MERGED; F11: WRONGLY_ADDED, MOVED_OUT, DUPLICATE
  // Rule 1 / F24: the membership record carries the relationship role
  // (relationship_types.code, or 'karta'), who it is relative to, and a status:
  // ACTIVE, REMOVED (F11), ENDED (divorce, death...). INVITED / REQUESTED live in
  // family_join_requests until accepted.
  relationshipRole   String?
  relativeToMemberId String?
  status             String    @default("ACTIVE")
  // Rule 2, enforced by the database: a STORED generated column (migration
  // 20261025100000_workbook_phases) that is 1 only on the active Karta row,
  // under unique(familyId, kartaGuard) — at most one active Karta per family.
  // Never written by the application. The dbgenerated text is PostgreSQL's
  // own rendering of the expression, so `migrate diff` sees no drift.
  kartaGuard         Int?      @default(dbgenerated("\nCASE\n    WHEN (\"isKarta\" AND (\"leftAt\" IS NULL)) THEN 1\n    ELSE NULL::integer\nEND"))

  family Family @relation(fields: [familyId], references: [id])
  member Member @relation(fields: [memberId], references: [id])

  @@unique([familyId, memberId])
  @@unique([familyId, kartaGuard])
  @@map("family_members")
}

// ─────────────────────────────────────────────────────────────────
// MEMBERS
// ─────────────────────────────────────────────────────────────────

model Member {
  id                    String         @id @default(cuid())
  memberNumber          String         @unique
  userId                String?        @unique
  firstName             String
  middleName            String?
  lastName              String?
  gender                Gender         @default(NOT_STATED)
  dateOfBirth           DateTime?
  dateOfBirthApprox     Boolean        @default(false)
  bloodGroup            String?
  heightCm              Int?
  weightKg              Int?
  bodyType              String?
  physicalDisability    String?
  mobilePrimary         String?
  mobileAlternate       String?
  /// CITEXT, like users.email: the Karta's duplicate check matches an address
  /// whatever case it was typed in. Not unique: a parent and child may share one.
  email                 String?        @db.Citext
  profilePhotoId        String?        @unique
  biography             String?        @db.Text
  currentCity           String?
  currentState          String?
  currentCountry        String?
  nativeVillage         String?
  nativeDistrict        String?
  nativeState           String?
  nationality           String         @default("Indian")
  languages             Json?          // JSON (jsonb) array of strings
  maritalStatus         MaritalStatus  @default(UNMARRIED)
  employmentStatus      String?
  occupationCategory    String?
  status                MemberStatus   @default(ACTIVE)
  deceasedAt            DateTime?
  deceasedPlace         String?
  deceasedNotes         String?        @db.Text
  deathCertKey          String? // F12: encrypted death certificate (secure-files), owner's decision
  deathCertMime         String?
  verificationStatus    VerificationStatus @default(UNVERIFIED)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  createdBy             String?
  updatedBy             String?
  deletedAt             DateTime?

  user                  User?          @relation(fields: [userId], references: [id])
  families              FamilyMember[]
  familiesAsKarta       Family[]       @relation("FamilyKarta")
  relationshipsFrom     MemberRelationship[] @relation("RelationshipFrom")
  relationshipsTo       MemberRelationship[] @relation("RelationshipTo")
  maritalHistory        MaritalStatusHistory[]
  marriageRecordsA      MarriageRecord[] @relation("MarriagePartnerA")
  marriageRecordsB      MarriageRecord[] @relation("MarriagePartnerB")
  addresses             Address[]
  education             EducationRecord[]
  employment            EmploymentRecord[]
  businesses            Business[]
  skills                MemberSkill[]
  matrimonialProfile    MatrimonialProfile?
  photos                Photo[]
  sentInterests         MatrimonialInterest[] @relation("InterestFrom")
  receivedInterests     MatrimonialInterest[] @relation("InterestTo")
  savedProfiles         MatrimonialSave[]  @relation("SavedBy")
  savedByProfiles       MatrimonialSave[]  @relation("Saved")
  memberAreas           MemberArea[]
  fieldVisibility       MemberFieldVisibility[]
  joinRequests          FamilyJoinRequest[]
  assets                Asset[]
  bookings              Booking[]
  payments              Payment[]
  feeInvoices           FeeInvoice[]
  profilePhoto          Photo?         @relation("ProfilePhoto", fields: [profilePhotoId], references: [id])
  groupsConvened        CommunityGroup[]       @relation("GroupConvener")
  communityGroups       CommunityGroupMember[]
  invitations           MemberInvitation[]
  profileDetails        MemberProfileDetail?
  additionalDetail        MemberAdditionalDetail?
  sectionSettings         MemberSectionSetting[]
  insurances              MemberInsurance[]
  vehicles                MemberVehicle[]
  loanNeeds               MemberLoanNeed[]
  farmHoldings            MemberFarmHolding[]
  sports                  MemberSport[]
  hobbies                 MemberHobby[]
  supportRequests         SupportRequest[]
  files                   MemberFile[]
  contactRequestsSent     ContactRequest[]        @relation("ContactRequestFrom")
  contactRequestsReceived ContactRequest[]        @relation("ContactRequestTo")
  idProofs                IdProof[]

  @@map("members")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  NOT_STATED
}

enum MaritalStatus {
  UNMARRIED
  MARRIED
  WIDOWED
  DIVORCED
  SEPARATED
  NOT_STATED
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  DECEASED
  SUSPENDED
}

model RelationshipType {
  id               String  @id @default(cuid())
  code             String  @unique
  label            String
  inverseCode      String?
  genderApplicable String? // MALE, FEMALE, ANY
  isSpouse         Boolean @default(false)
  // Workbook "Relationships" sheet columns.
  localName        String? // Hindi / Marathi
  generation       Int? // relative to Karta: +1 = one up, -1 = one down
  side             String? // PATERNAL, MATERNAL, HUSBAND_SIDE, WIFE_SIDE, SPOUSE_SIDE
  linkType         String? // BIRTH, MARRIAGE, BIRTH_OR_ADOPTION
  isActive         Boolean @default(true)
  sortOrder        Int     @default(0)

  relationships MemberRelationship[]

  @@map("relationship_types")
}

model MemberRelationship {
  id                 String   @id @default(cuid())
  fromMemberId       String
  toMemberId         String
  relationshipTypeId String
  familyId           String?
  isActive           Boolean  @default(true)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdBy          String?

  fromMember       Member           @relation("RelationshipFrom", fields: [fromMemberId], references: [id])
  toMember         Member           @relation("RelationshipTo", fields: [toMemberId], references: [id])
  relationshipType RelationshipType @relation(fields: [relationshipTypeId], references: [id])

  @@unique([fromMemberId, toMemberId, relationshipTypeId])
  @@map("member_relationships")
}

model MaritalStatusHistory {
  id            String        @id @default(cuid())
  memberId      String
  status        MaritalStatus
  effectiveDate DateTime?
  notes         String?
  changedBy     String?
  approvalId    String?
  createdAt     DateTime      @default(now())

  member   Member    @relation(fields: [memberId], references: [id])
  approval Approval? @relation(fields: [approvalId], references: [id])

  @@map("marital_status_history")
}

model MarriageRecord {
  id                 String    @id @default(cuid())
  memberId1          String
  memberId2          String?
  externalSpouseName String?
  externalSpouseInfo Json?
  marriageDate       DateTime?
  marriagePlace      String?
  status             String    @default("MARRIED") // MARRIED, DIVORCED, WIDOWED
  dissolutionDate    DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdBy          String?

  partnerA Member  @relation("MarriagePartnerA", fields: [memberId1], references: [id])
  partnerB Member? @relation("MarriagePartnerB", fields: [memberId2], references: [id])

  @@map("marriage_records")
}

// ─────────────────────────────────────────────────────────────────
// PROFESSIONAL PROFILE
// ─────────────────────────────────────────────────────────────────

model EducationRecord {
  id             String   @id @default(cuid())
  memberId       String
  level          String? // SCHOOL, DIPLOMA, ITI, UG, PG, DOCTORATE, PROFESSIONAL, OTHER
  qualification  String?
  specialization String?
  institution    String?
  university     String?
  grade          String?
  yearCompleted  Int?
  isHighest      Boolean  @default(false)
  isOngoing      Boolean  @default(false)
  // Additional Details §8 — marks for this degree/class. Year passed is the
  // existing yearCompleted column; these extend the row, never duplicate it.
  marksType       String? // PERCENTAGE, CGPA, GRADE
  marksValue      String?
  marksScale      Int? // 100, 10, 4
  boardUniversity String?
  marksheetFileId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id])

  @@map("education_records")
}

model EmploymentRecord {
  id             String    @id @default(cuid())
  memberId       String
  employmentType String? // JOB, BUSINESS, PROFESSION, AGRICULTURE, OTHER
  employerName   String?
  designation    String?
  industry       String?
  city           String?
  country        String?
  incomeRangeId  String?
  startDate      DateTime?
  endDate        DateTime?
  isCurrent      Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  member      Member       @relation(fields: [memberId], references: [id])
  incomeRange IncomeRange? @relation(fields: [incomeRangeId], references: [id])

  @@map("employment_records")
}

model Business {
  id              String   @id @default(cuid())
  memberId        String
  businessName    String?
  businessType    String?
  industry        String?
  city            String?
  country         String?
  description     String?  @db.Text
  website         String?
  establishedYear Int?
  incomeRangeId   String?
  isActive        Boolean  @default(true)
  // Additional Details §12 — business directory listing.
  contact         String?
  showInDirectory Boolean? @default(false)
  supportNeeds    Json? // array: CUSTOMERS, FUNDING, MENTORING, GOVT_SCHEME, DIGITAL_PRESENCE
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  member      Member       @relation(fields: [memberId], references: [id])
  incomeRange IncomeRange? @relation(fields: [incomeRangeId], references: [id])

  @@map("businesses")
}

model Skill {
  id        String  @id @default(cuid())
  name      String  @unique
  category  String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  memberSkills MemberSkill[]

  @@map("skills")
}

model MemberSkill {
  memberId String
  skillId  String
  level    String? // BEGINNER, INTERMEDIATE, EXPERT

  member Member @relation(fields: [memberId], references: [id])
  skill  Skill  @relation(fields: [skillId], references: [id])

  @@id([memberId, skillId])
  @@map("member_skills")
}

model IncomeRange {
  id        String  @id @default(cuid())
  label     String // "₹5–10 lakh"
  minValue  BigInt?
  maxValue  BigInt?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  employmentRecords      EmploymentRecord[]
  businesses             Business[]
  matrimonialPreferences MatrimonialPreference[]

  @@map("income_ranges")
}

// ─────────────────────────────────────────────────────────────────
// ADDRESSES
// ─────────────────────────────────────────────────────────────────

model Address {
  id              String   @id @default(cuid())
  addressableType String // family | member
  familyId        String?
  memberId        String?
  addressType     String // CURRENT, NATIVE, WORK, OTHER
  line1           String?
  line2           String?
  city            String?
  district        String?
  state           String?
  country         String   @default("India")
  pincode         String?
  taluka          String?
  // F02: location-master link (Village/City) for this address; the text
  // columns above are kept filled from it for display and search.
  areaId          String?
  sameAsCurrent   Boolean  @default(false) // PERMANENT address copied from CURRENT
  // Geo-tag (WGS84) from the browser or an adjusted map pin. Optional, so a
  // member who denies location access can still save the address.
  latitude        Float?
  longitude       Float?
  isPrimary       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  family Family? @relation(fields: [familyId], references: [id], onDelete: Cascade)
  member Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  area   Area?   @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@map("addresses")
}

// ─────────────────────────────────────────────────────────────────
// PERSONAL PROFILE DETAILS
// ─────────────────────────────────────────────────────────────────

// Extra personal-information answers from the Edit Profile form. One row per
// member, created on first save — existing members have no row, which reads
// as "everything empty". Fields under a toggle are only ever stored while
// that toggle is on (enforced in src/lib/profile-details.ts).
model MemberProfileDetail {
  id                   String  @id @default(cuid())
  memberId             String  @unique
  educationLevel       String? // NONE, PRIMARY, SECONDARY, HIGHER_SECONDARY, ITI, DIPLOMA, GRADUATE, POST_GRADUATE, DOCTORATE, PROFESSIONAL, OTHER
  educationOther       String? // free text, only when educationLevel = OTHER
  educationStream      String?
  educationInstitution String?
  annualIncomeRange    String? // BELOW_2L, 2L_5L, 5L_10L, 10L_20L, 20L_50L, ABOVE_50L, NOT_SAY

  // F02 occupation (any marital status). Social status itself is
  // members.employmentStatus: STUDENT, WORKING, RETIRED, HOMEMAKER, NOT_WORKING.
  incomeSource    String? // SERVICE, BUSINESS, PROFESSIONAL (when WORKING)
  serviceType     String? // GOVT, PRIVATE, PSU, OTHER (when SERVICE)
  employerName    String?
  occBusinessType String? // when BUSINESS
  occBusinessName String?
  profession      String? // DOCTOR, CA, LAWYER, ENGINEER, OTHER (when PROFESSIONAL)
  professionOther String?

  // Unmarried-only flow
  isEarning              Boolean @default(false)
  isPursuingEducation    Boolean @default(false)
  currentCourse          String?
  currentInstitution     String?
  expectedCompletionYear Int?
  earningType            String? // JOB, BUSINESS
  companyName            String?
  designation            String?
  jobSector              String? // GOVERNMENT, PRIVATE, OTHER
  businessName           String?
  businessType           String?
  readyForMarriage       Boolean @default(false)
  lookingForMarriage     Boolean @default(false)
  marriageHeightCm       Int?
  motherTongue           String?
  nativePlace            String?
  partnerExpectations    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_profile_details")
}

// ─────────────────────────────────────────────────────────────────
// ADDITIONAL DETAILS (extended personal details, 23 optional sections)
//
// Section definitions, option lists, conditional rules and privacy caps live
// in src/lib/additional-details/. Amounts are always bands, never figures.
// No policy, account, card, PAN, CIBIL, 7/12 or survey numbers, and no
// illness/diagnosis/treatment data is ever stored here.
// ─────────────────────────────────────────────────────────────────

/// One row per member per section: the opening Yes / No / Prefer-not-to-say
/// answer, who may see the section, and who entered it (a Karta entering for
/// a child or elder leaves a note).
model MemberSectionSetting {
  id              String   @id @default(cuid())
  memberId        String
  sectionKey      String
  answer          String? // YES, NO, PREFER_NOT
  visibility      String? // ONLY_ME, KARTA, FAMILY, COMMUNITY_BODIES, COMMUNITY
  enteredByUserId String?
  entryNote       String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, sectionKey])
  @@map("member_section_settings")
}

/// The single-row sections (2, 3, 5-shared, 7, 8-support, 11, 13–23), one row
/// per member. Multi-select answers are JSON arrays of option values.
model MemberAdditionalDetail {
  id                       String   @id @default(cuid())
  memberId                 String   @unique
  // 1 Insurance (help only — policies are rows in member_insurances)
  insuranceNeedsHelp       Boolean?
  insuranceHelpNote        String?  @db.Text
  // 2 Family doctor
  doctorName               String?
  doctorSpeciality         String?
  doctorClinic             String?
  doctorCity               String?
  doctorContact            String?
  doctorNeedsHelp          Boolean?
  // 3 Investment manager / financial adviser
  adviserName              String?
  adviserType              String?
  adviserContact           String?
  adviserNeedsGuidance     Boolean?
  // 5 Banking (loan rows are in member_loan_needs)
  hasExistingLoans         Boolean?
  existingLoanTypes        Json?
  otherBankingNeeds        Json?
  // 7 House (address is the existing CURRENT address — never duplicated)
  houseOwnership           String?
  houseType                String?
  houseWantsToBuy          Boolean?
  // 8 Education support (marks are on education_records)
  eduNeedsSupport          Boolean?
  eduSupportTypes          Json?
  eduSupportAmountBand     String?
  eduSupportNote           String?  @db.Text
  // 11 Career and work
  careerLookingFor         Json?
  careerSkills             Json?
  careerPreferredCity      String?
  careerExperienceBand     String?
  careerCanOffer           Json?
  careerOfferField         String?
  careerSupportNeeds       Json?
  // 13 Skills I can share
  teachSubjects            String?
  teachMode                String?
  teachFeeMode             String?
  guidanceFields           Json?
  volunteerReady           Boolean?
  volunteerHoursBand       String?
  willingToDonateBlood     Boolean?
  lastDonatedMonth         String? // YYYY-MM; shown only in the blood donor finder flow
  // 14 Health and fitness (wellness only)
  wellnessActivities       Json?
  wellnessWants            Json?
  // 15 Senior citizen needs
  seniorLivesWith          String?
  seniorNeeds              Json?
  seniorEmergencyMemberId  String?
  // 16 Children and students
  studentClassCourse       String?
  studentCareerInterest    String?
  studentNeeds             Json?
  studentExamName          String?
  // 17 Women's support
  womenInterests           Json?
  womenNeeds               Json?
  // 18 Government documents and scheme help (tick-list only)
  govDocNeeds              Json?
  // 19 Housing and relocation
  housingLookingTo         Json?
  housingCity              String?
  housingBudgetBand        String?
  relocatingCity           String?
  relocatingWantsContacts  Boolean?
  // 20 Travel and events
  travelInterests          Json?
  travelCanHost            Boolean?
  // 21 Language, culture and social (languages spoken = members.languages)
  motherTongue             String?
  cultureInterests         Json?
  openToCityFriends        Boolean?
  openToMulGaon            Boolean?
  openToProfession         Boolean?
  // 22 Marriage-related support
  marriageSupportNeeds     Json?
  // 23 Emergency readiness
  emergencyContactMemberId String?
  canHelpEmergency         Boolean?
  emergencyHelpTypes       Json?
  // Interest-group preferences
  autoAddToGroups          Boolean? @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_additional_details")
}

/// §1 Insurance (many). No policy numbers.
model MemberInsurance {
  id             String   @id @default(cuid())
  memberId       String
  insuranceType  String?
  insurerName    String?
  sumInsuredBand String?
  renewalMonth   Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("member_insurances")
}

/// §4 Vehicles and servicing (many). Registration shown masked to others.
model MemberVehicle {
  id                    String   @id @default(cuid())
  memberId              String
  vehicleType           String?
  make                  String?
  model                 String?
  year                  Int?
  fuelType              String?
  lastServiceMonth      String?
  nextServiceDueMonth   String?
  preferredGarage       String?
  needsServicingSupport Boolean?
  servicingSupportNote  String?  @db.Text
  registrationNumber    String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("member_vehicles")
}

/// §5 Loan requirements (many). No account/card numbers, CIBIL or PAN.
model MemberLoanNeed {
  id            String   @id @default(cuid())
  memberId      String
  loanType      String?
  amountBand    String?
  purpose       String?
  neededByMonth String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("member_loan_needs")
}

/// §6 Farm holding (many). District from the areas master; no 7/12 or survey numbers.
model MemberFarmHolding {
  id             String   @id @default(cuid())
  memberId       String
  districtAreaId String?
  district       String?
  taluka         String?
  village        String?
  areaValue      Float?
  areaUnit       String?
  ownership      String?
  irrigated      Boolean?
  mainCrops      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("member_farm_holdings")
}

/// §9 Sports (many); medals and certificates are child rows.
model MemberSport {
  id                   String   @id @default(cuid())
  memberId             String
  interestId           String?
  level                String?
  needsCoachingSupport Boolean?
  supportTypes         Json?
  supportNote          String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  member       Member                   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  interest     Interest?                @relation(fields: [interestId], references: [id])
  achievements MemberSportAchievement[]

  @@index([memberId])
  @@map("member_sports")
}

model MemberSportAchievement {
  id                String   @id @default(cuid())
  sportId           String
  eventName         String?
  year              Int?
  medal             String?
  certificateFileId String?
  createdAt         DateTime @default(now())

  sport MemberSport @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@map("member_sport_achievements")
}

/// §10 Hobbies and interests (many) — drives the interest groups.
model MemberHobby {
  id           String   @id @default(cuid())
  memberId     String
  interestId   String
  level        String? // BEGINNER, REGULAR, EXPERT
  detail       String? // "which instrument / which dance"
  canTeach     Boolean?
  needsSupport Boolean?
  supportTypes Json?
  supportNote  String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id])

  @@unique([memberId, interestId])
  @@map("member_hobbies")
}

/// Hobby / sport master list (§10, §9). Members' "Other" entries arrive as
/// PENDING and only get a group once an Admin approves (or merges) them.
model Interest {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  category            String?
  isSport             Boolean?  @default(false)
  isChildSafe         Boolean?  @default(false)
  status              String?   @default("APPROVED") // PENDING, APPROVED, REJECTED, MERGED
  mergedIntoId        String?
  suggestedByMemberId String?
  reviewedBy          String?
  reviewedAt          DateTime?
  sortOrder           Int?      @default(0)
  isActive            Boolean?  @default(true)
  createdAt           DateTime  @default(now())

  hobbies MemberHobby[]
  sports  MemberSport[]
  groups  CommunityGroup[]

  @@index([status])
  @@map("interests")
}

/// Admin-editable dropdown values (rule 11). When a list has no rows here the
/// built-in defaults in src/lib/additional-details/options.ts apply.
model OptionMaster {
  id        String   @id @default(cuid())
  listKey   String
  value     String
  label     String
  sortOrder Int?     @default(0)
  isActive  Boolean? @default(true)
  updatedAt DateTime @updatedAt

  @@unique([listKey, value])
  @@map("option_masters")
}

/// A "needs help" answer the member chose to share with the community support
/// team (rule 3). District team of that district sees names; State/National
/// see counts only.
model SupportRequest {
  id              String    @id @default(cuid())
  memberId        String
  sourceKey       String // e.g. insurance, education, vehicle:<rowId>, hobby:<interestId>
  category        String // EDUCATION, SPORTS, LOAN, INSURANCE, DOCTOR, SERVICING, …
  district        String?
  note            String?   @db.Text
  status          String?   @default("OPEN") // OPEN, WITHDRAWN, CLOSED
  createdByUserId String?
  createdAt       DateTime  @default(now())
  withdrawnAt     DateTime?
  closedAt        DateTime?
  closedBy        String?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, sourceKey, status])
  @@index([category, status])
  @@map("support_requests")
}

/// Private uploads for this area (marksheets, sport certificates). Stored via
/// src/lib/storage.ts, outside the public web root; served only through
/// /api/member-files/[id] after a visibility check.
model MemberFile {
  id               String   @id @default(cuid())
  memberId         String
  purpose          String // MARKSHEET, CERTIFICATE
  storageKey       String
  originalFilename String?
  mimeType         String?
  sizeBytes        Int?
  uploadedBy       String?
  createdAt        DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("member_files")
}

/// "Request contact": blood donor finder and matching suggestions. A phone
/// number is shared only once the recipient accepts.
model ContactRequest {
  id           String    @id @default(cuid())
  purpose      String // BLOOD_DONOR, CONNECT
  fromMemberId String
  toMemberId   String
  message      String?   @db.Text
  status       String?   @default("PENDING") // PENDING, ACCEPTED, DECLINED
  respondedAt  DateTime?
  createdAt    DateTime  @default(now())

  fromMember Member @relation("ContactRequestFrom", fields: [fromMemberId], references: [id], onDelete: Cascade)
  toMember   Member @relation("ContactRequestTo", fields: [toMemberId], references: [id], onDelete: Cascade)

  @@index([toMemberId, status])
  @@map("contact_requests")
}

/// Group polls and event RSVPs (group posts reuse the posts table).
model PostPollOption {
  id        String @id @default(cuid())
  postId    String
  label     String
  sortOrder Int?   @default(0)

  post  Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes PostPollVote[]

  @@map("post_poll_options")
}

model PostPollVote {
  id        String   @id @default(cuid())
  postId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  post   Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  option PostPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_poll_votes")
}

model PostRsvp {
  postId    String
  userId    String
  response  String? // GOING, MAYBE, NOT_GOING
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("post_rsvps")
}

// ─────────────────────────────────────────────────────────────────
// MATRIMONY
// ─────────────────────────────────────────────────────────────────

model MatrimonialProfile {
  id         String  @id @default(cuid())
  memberId   String  @unique
  isVisible  Boolean @default(false)
  about      String? @db.Text
  heightCm   Int?
  // A JSON (jsonb) array of strings. It was a native String[] before the
  // MySQL interlude and stayed JSON on the way back, so existing read sites
  // and migrated MySQL rows need no conversion. Nullable; application code
  // treats a missing value as an empty list.
  languages  Json?
  /// F37 extra details.
  expectations      String?  @db.Text
  horoscope         String?  @db.Text
  contactPreference String? // SELF, KARTA, BOTH — who is contacted once an interest is accepted
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String?

  member      Member                 @relation(fields: [memberId], references: [id])
  preferences MatrimonialPreference?

  @@map("matrimonial_profiles")
}

model MatrimonialPreference {
  id                   String   @id @default(cuid())
  matrimonialProfileId String   @unique
  minAge               Int?
  maxAge               Int?
  preferredGender      Gender?
  // JSON arrays — see the comment on MatrimonialProfile.languages above.
  preferredLocations   Json?
  educationPreference  String?
  occupationPreference String?
  incomeRangeId        String?
  maritalStatusPref    Json? // array of MaritalStatus values
  otherPreferences     Json?
  updatedAt            DateTime @updatedAt

  matrimonialProfile MatrimonialProfile @relation(fields: [matrimonialProfileId], references: [id])
  incomeRange        IncomeRange?       @relation(fields: [incomeRangeId], references: [id])

  @@map("matrimonial_preferences")
}

model MatrimonialInterest {
  id              String    @id @default(cuid())
  fromMemberId    String
  toMemberId      String
  message         String?   @db.Text
  status          String    @default("PENDING") // PENDING, ACCEPTED, DECLINED, WITHDRAWN
  statusChangedAt DateTime?
  statusNote      String?
  /// F38: the user who answered — the person, or the Karta on their behalf.
  respondedBy     String?
  createdAt       DateTime  @default(now())

  fromMember Member @relation("InterestFrom", fields: [fromMemberId], references: [id])
  toMember   Member @relation("InterestTo", fields: [toMemberId], references: [id])

  @@map("matrimonial_interests")
}

model MatrimonialSave {
  memberId      String
  savedMemberId String
  savedAt       DateTime @default(now())

  member      Member @relation("SavedBy", fields: [memberId], references: [id])
  savedMember Member @relation("Saved", fields: [savedMemberId], references: [id])

  @@id([memberId, savedMemberId])
  @@map("matrimonial_saves")
}

// ─────────────────────────────────────────────────────────────────
// COMMUNITY & AREAS
// ─────────────────────────────────────────────────────────────────

model Area {
  id        String  @id @default(cuid())
  parentId  String?
  name      String
  type      String // location master: COUNTRY, STATE, DISTRICT, TALUKA, VILLAGE, CITY; legacy: AREA, GROUP
  code      String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  parent          Area?            @relation("AreaHierarchy", fields: [parentId], references: [id])
  children        Area[]           @relation("AreaHierarchy")
  memberAreas     MemberArea[]
  familyAreas     FamilyArea[]
  posts           Post[]
  userRoles       UserRole[]
  communityGroups CommunityGroup[]
  addresses       Address[]

  @@map("areas")
}

model MemberArea {
  memberId  String
  areaId    String
  isPrimary Boolean @default(false)

  member Member @relation(fields: [memberId], references: [id])
  area   Area   @relation(fields: [areaId], references: [id])

  @@id([memberId, areaId])
  @@map("member_areas")
}

model FamilyArea {
  familyId  String
  areaId    String
  isPrimary Boolean @default(false)

  family Family @relation(fields: [familyId], references: [id])
  area   Area   @relation(fields: [areaId], references: [id])

  @@id([familyId, areaId])
  @@map("family_areas")
}

/// A small local body within the community — a mandal or similar — that meets
/// in a particular area and carries a roster of roughly 20–25 members. Kept
/// separate from Area: an Area is geography, a group is a body of people with
/// a convener, a roster and a review cadence.
model CommunityGroup {
  id                       String      @id @default(cuid())
  name                     String
  code                     String?     @unique
  groupType                String      @default("MANDAL") // MANDAL, YUVAK_MANDAL, MAHILA_MANDAL, BHAJAN_MANDAL, SENIOR, YOUTH, OTHER
  description              String?     @db.Text
  areaId                   String?
  convenerMemberId         String?
  meetingSchedule          String? // free text, e.g. "Second Sunday, 6pm"
  /// Guidance size for the roster. Enforced only when set.
  maxMembers               Int?        @default(25)
  status                   GroupStatus @default(PENDING_APPROVAL)
  reviewedBy               String?
  reviewedAt               DateTime?
  reviewNote               String?     @db.Text
  /// Roster upkeep: when the membership list was last confirmed as current,
  /// and how often it should be. Drives the "review due" prompt.
  lastRosterReviewAt   DateTime?
  lastRosterReviewBy   String?
  rosterReviewIntervalDays Int   @default(180)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdBy      String?
  deletedAt      DateTime?
  // ── Interest groups (groupType = INTEREST) ──────────────────────
  // Created automatically from members' Additional Details answers. autoKey
  // is "<groupKey>|<district or empty>", so the community-level group and
  // each district sub-group are unique.
  groupKey                 String? // interest:<interestId>, derived:CAREER, exam:NEET, profession:TEACHER …
  autoKey                  String?     @unique
  interestId               String?
  parentGroupId            String?
  district                 String?
  isChildSafe              Boolean?    @default(false)
  rules                    String?     @db.Text

  area     Area?                  @relation(fields: [areaId], references: [id])
  convener Member?                @relation("GroupConvener", fields: [convenerMemberId], references: [id])
  members  CommunityGroupMember[]
  interest  Interest?              @relation(fields: [interestId], references: [id])
  parent    CommunityGroup?        @relation("GroupSubGroups", fields: [parentGroupId], references: [id])
  subGroups CommunityGroup[]       @relation("GroupSubGroups")
  posts     Post[]

  @@index([status, isActive])
  @@index([groupType, parentGroupId])
  @@map("community_groups")
}

enum GroupStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  REJECTED
  INACTIVE
}

model CommunityGroupMember {
  id          String    @id @default(cuid())
  groupId     String
  memberId    String
  /// CONVENER, SECRETARY, TREASURER, MEMBER
  roleInGroup String    @default("MEMBER")
  joinedAt    DateTime  @default(now())
  addedBy     String?
  /// Members are retired from a roster rather than deleted, so the group's
  /// history stays intact across periodic updates.
  leftAt     DateTime?
  leftReason      String? // interest groups: LEFT_BY_MEMBER and REMOVED_BY_MODERATOR are never auto-re-added; NO_LONGER_MATCHES may be
  // ── Interest-group membership settings ──────────────────────────
  autoJoined      Boolean?  @default(false)
  notifyMode      String?   @default("DAILY_DIGEST") // DAILY_DIGEST, EVERY_POST
  isMuted         Boolean?  @default(false)
  rulesAcceptedAt DateTime?
  lastDigestAt    DateTime?

  group  CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member Member         @relation(fields: [memberId], references: [id])

  @@unique([groupId, memberId])
  @@index([memberId])
  @@map("community_group_members")
}

model PostType {
  id               String  @id @default(cuid())
  code             String  @unique
  label            String
  icon             String?
  requiresApproval Boolean @default(false)
  isActive         Boolean @default(true)

  posts Post[]

  @@map("post_types")
}

model Post {
  id             String     @id @default(cuid())
  authorId       String
  postTypeId     String
  title          String?
  content        String?    @db.Text
  visibility     String     @default("COMMUNITY") // LOCAL_AREA, CITY, STATE, COMMUNITY, PRIVATE
  targetAreaId   String?
  /// F36 audience: COMMUNITY (everyone, as before), FAMILY, FRIEND_LIST,
  /// ORGANISATION (audienceId = the id), DISTRICT / STATE (audienceId = area),
  /// NATIONAL. District / State / National posts are moderated by that body.
  audienceType   String     @default("COMMUNITY")
  audienceId     String?
  // Community posts are held for moderation by default — nothing reaches the
  // feed until an Operator or Admin approves it.
  status         PostStatus @default(PENDING_APPROVAL)
  reviewedBy     String?
  reviewedAt     DateTime?
  reviewNote     String?    @db.Text
  isPinned       Boolean    @default(false)
  isAnnouncement Boolean    @default(false)
  eventDate      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?
  // ── Interest-group posts. NULL groupId = an ordinary community post. ──
  groupId         String?
  groupPostKind   String? // POST, QUESTION, KNOWLEDGE, EVENT, POLL
  linkUrl         String?    @db.Text
  isSolved        Boolean?   @default(false)
  solvedAt        DateTime?
  solvedCommentId String?

  author   User     @relation(fields: [authorId], references: [id])
  postType PostType @relation(fields: [postTypeId], references: [id])
  area     Area?    @relation(fields: [targetAreaId], references: [id])
  group       CommunityGroup?  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  comments Comment[]
  reactions Reaction[]
  photos   Photo[]
  pollOptions PostPollOption[]
  pollVotes   PostPollVote[]
  rsvps       PostRsvp[]

  @@index([groupId, status])
  @@index([audienceType, audienceId])
  @@map("posts")
}

enum PostStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  REJECTED
  HIDDEN
  REMOVED
  FLAGGED
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  authorId  String
  parentId  String?
  content   String    @db.Text
  status    String    @default("ACTIVE") // ACTIVE, HIDDEN, REMOVED
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User       @relation(fields: [authorId], references: [id])
  parent    Comment?   @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[]  @relation("CommentReplies")
  reactions Reaction[]

  @@map("comments")
}

model Reaction {
  id           String   @id @default(cuid())
  postId       String?
  commentId    String?
  userId       String
  reactionType String   @default("LIKE") // LIKE, LOVE, SUPPORT, CELEBRATE, CONDOLENCE
  createdAt    DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id])
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@unique([commentId, userId])
  @@map("reactions")
}

model Report {
  id             String    @id @default(cuid())
  reportableType String // post | comment | member | photo | matrimonial_profile
  reportableId   String
  reporterId     String
  reason         String
  description    String?   @db.Text
  status         String    @default("PENDING") // PENDING, UNDER_REVIEW, RESOLVED, DISMISSED
  resolvedBy     String?
  resolutionNote String?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  reporter User @relation(fields: [reporterId], references: [id])

  @@index([reportableType, reportableId])
  @@map("reports")
}

// ─────────────────────────────────────────────────────────────────
// COMMUNITY ASSETS, BOOKINGS, PAYMENTS & FEES
//
// Money is stored as INTEGER PAISE everywhere (₹2,000 = 200000). No float
// ever touches a monetary value.
// ─────────────────────────────────────────────────────────────────

model Asset {
  id            String      @id @default(cuid())
  ownerMemberId String
  name          String
  assetType     String // HALL, GUESTHOUSE, LAWN, EQUIPMENT, VEHICLE, OTHER
  description   String?     @db.Text
  // Location
  addressLine   String?
  city          String?
  district      String?
  state         String?
  pincode       String?
  // Capacity & facilities
  capacity      Int?
  // JSON array of strings — see the comment on MatrimonialProfile.languages.
  facilities    Json?
  // Rates in paise. Which one applies depends on bookingMode.
  bookingMode   String      @default("DAILY") // DAILY | HOURLY
  ratePerDay    Int?
  ratePerHour   Int?
  // Community assets are reviewed before members can see or book them.
  status        AssetStatus @default(DRAFT)
  reviewedBy    String?
  reviewedAt    DateTime?
  reviewNote    String?     @db.Text
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  owner     Member          @relation(fields: [ownerMemberId], references: [id])
  bookings  Booking[]
  blackouts AssetBlackout[]
  photos    Photo[]

  @@index([status, isActive])
  @@map("assets")
}

enum AssetStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
}

/// Owner-declared unavailability (maintenance, private use).
model AssetBlackout {
  id        String   @id @default(cuid())
  assetId   String
  startAt   DateTime
  endAt     DateTime
  reason    String?
  createdAt DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, startAt, endAt])
  @@map("asset_blackouts")
}

/// Double-booking prevention is enforced by the database: the exclusion
/// constraint `bookings_no_overlap` (GiST, needs the btree_gist extension)
/// makes two PENDING_PAYMENT/CONFIRMED bookings of the same asset with
/// overlapping [startAt, endAt) ranges impossible. Prisma cannot declare it,
/// so it is created in the baseline migration SQL. The booking route also
/// locks the Asset row (`SELECT ... FOR UPDATE`) and checks for overlap first,
/// so the usual case gets a clean 409 instead of a constraint error.
model Booking {
  id             String        @id @default(cuid())
  reference      String        @unique
  assetId        String
  memberId       String
  bookedByUserId String
  startAt        DateTime
  endAt          DateTime
  status         BookingStatus @default(PENDING_PAYMENT)
  amountPaise    Int
  guestCount     Int?
  notes          String?       @db.Text
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  asset    Asset     @relation(fields: [assetId], references: [id])
  member   Member    @relation(fields: [memberId], references: [id])
  payments Payment[]

  @@index([assetId, startAt, endAt])
  @@index([memberId])
  @@map("bookings")
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  REJECTED
  EXPIRED
}

/// One row per payment attempt. The gateway is pluggable; MOCK lets the whole
/// flow be exercised without live credentials. Status is only ever advanced
/// from server-side verification — never from what the browser reports.
model Payment {
  id               String        @id @default(cuid())
  reference        String        @unique
  purpose          String // BOOKING | FEE
  bookingId        String?
  feeInvoiceId     String?
  memberId         String
  paidByUserId     String
  amountPaise      Int
  currency         String        @default("INR")
  status           PaymentStatus @default(CREATED)
  gateway          String        @default("MOCK")
  gatewayOrderId   String?
  gatewayPaymentId String?
  failureReason    String?
  paidAt           DateTime?
  refundedPaise    Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  booking    Booking?    @relation(fields: [bookingId], references: [id])
  feeInvoice FeeInvoice? @relation(fields: [feeInvoiceId], references: [id])
  member     Member      @relation(fields: [memberId], references: [id])

  @@index([memberId])
  @@index([status])
  @@map("payments")
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

/// Admin-configurable fee definitions, e.g. one-time family registration.
model FeeType {
  id          String   @id @default(cuid())
  code        String   @unique // FAMILY_REGISTRATION
  label       String
  description String?
  amountPaise Int
  appliesTo   String   @default("FAMILY_KARTA") // who is billed
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  invoices FeeInvoice[]

  @@map("fee_types")
}

model FeeInvoice {
  id           String           @id @default(cuid())
  reference    String           @unique
  feeTypeId    String
  familyId     String?
  memberId     String
  amountPaise  Int
  status       FeeInvoiceStatus @default(PENDING)
  dueDate      DateTime?
  paidAt       DateTime?
  waivedBy     String?
  waiverReason String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  feeType  FeeType   @relation(fields: [feeTypeId], references: [id])
  family   Family?   @relation(fields: [familyId], references: [id])
  member   Member    @relation(fields: [memberId], references: [id])
  payments Payment[]

  @@index([memberId, status])
  @@map("fee_invoices")
}

enum FeeInvoiceStatus {
  PENDING
  PAID
  WAIVED
  CANCELLED
}

// ─────────────────────────────────────────────────────────────────
// MEDIA
// ─────────────────────────────────────────────────────────────────

model Photo {
  id               String   @id @default(cuid())
  ownerType        String // member | family | post | asset
  memberId         String?
  familyId         String?
  postId           String?
  assetId          String?
  uploadedBy       String
  storageKey       String // S3 key (not public URL)
  thumbnailKey     String?
  optimizedKey     String?
  originalFilename String?
  mimeType         String?
  fileSizeBytes    BigInt?
  width            Int?
  height           Int?
  isProfilePhoto   Boolean  @default(false)
  caption          String?
  visibility       String   @default("PRIVATE") // PRIVATE, SAME_FAMILY, FRIENDS, FRIEND_LIST, REGISTERED_MEMBERS, SAME_AREA, MATRIMONY_ONLY, PUBLIC_COMMUNITY, ADMIN_OPERATOR
  /// F34: with visibility FRIEND_LIST, the uploader's friend list that may see it.
  audienceListId   String?
  status           String   @default("ACTIVE") // ACTIVE, FLAGGED, REMOVED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  uploader  User    @relation(fields: [uploadedBy], references: [id])
  member    Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)
  family    Family? @relation(fields: [familyId], references: [id], onDelete: Cascade)
  post      Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)
  asset     Asset?  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  profileOf Member? @relation("ProfilePhoto")

  @@map("photos")
}

// ─────────────────────────────────────────────────────────────────
// APPROVAL WORKFLOW & AUDIT
// ─────────────────────────────────────────────────────────────────

model ApprovalRule {
  id               String   @id @default(cuid())
  actionCode       String   @unique
  requiresApproval Boolean  @default(true)
  approverRole     String? // OPERATOR | ADMIN
  autoApproveRole  String?
  isActive         Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  @@map("approval_rules")
}

model Approval {
  id             String         @id @default(cuid())
  actionCode     String
  entityType     String? // member | family | relationship | etc.
  entityId       String?
  fieldName      String?
  oldValue       Json?
  newValue       Json?
  status         ApprovalStatus @default(SUBMITTED)
  submittedBy    String
  submittedAt    DateTime       @default(now())
  reviewedBy     String?
  reviewedAt     DateTime?
  reviewNote     String?        @db.Text
  reason         String?        @db.Text
  escalatedTo    String?
  escalatedAt    DateTime?
  escalationNote String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  submitter              User                   @relation("ApprovalSubmitter", fields: [submittedBy], references: [id])
  reviewer               User?                  @relation("ApprovalReviewer", fields: [reviewedBy], references: [id])
  maritalStatusHistories MaritalStatusHistory[]

  @@map("approvals")
}

enum ApprovalStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RETURNED
  ESCALATED
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorRole  String?
  action     String
  entityType String?
  entityId   String?
  fieldName  String?
  oldValue   Json?
  newValue   Json?
  approvalId String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())
  // IMMUTABLE: no updatedAt, no deletedAt

  actor User @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────

model Notification {
  id          String    @id @default(cuid())
  recipientId String
  senderId    String?
  type        String // APPROVAL_STATUS, MATRIMONIAL_INTEREST, COMMUNITY_POST, ANNOUNCEMENT, BIRTHDAY, SYSTEM
  title       String
  body        String?   @db.Text
  data        Json?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  emailSent   Boolean   @default(false)
  smsSent     Boolean   @default(false)
  createdAt   DateTime  @default(now())

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id])
  sender    User? @relation("NotificationSender", fields: [senderId], references: [id])

  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────
// SETTINGS & PRIVACY
// ─────────────────────────────────────────────────────────────────

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

model FieldVisibilityDefault {
  entityType         String
  fieldName          String
  defaultVisibility  String // PUBLIC_COMMUNITY, REGISTERED_MEMBERS, SAME_AREA, SAME_FAMILY, MATRIMONY_ONLY, ADMIN_OPERATOR, PRIVATE
  isUserConfigurable Boolean @default(true)

  @@id([entityType, fieldName])
  @@map("field_visibility_defaults")
}

model MemberFieldVisibility {
  memberId   String
  fieldName  String
  visibility String // same options as above

  member Member @relation(fields: [memberId], references: [id])

  @@id([memberId, fieldName])
  @@map("member_field_visibility")
}

model BlockedUser {
  blockerId String
  blockedId String
  reason    String?
  blockedAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id])
  blocked User @relation("Blocked", fields: [blockedId], references: [id])

  @@id([blockerId, blockedId])
  @@map("blocked_users")
}

// ─────────────────────────────────────────────────────────────────
// P1 VERIFICATION: ID PROOF, DUAL BLIND APPROVAL, CHANGE REQUESTS
// ─────────────────────────────────────────────────────────────────

/// F03. Files are AES-256-GCM encrypted before they reach storage (outside
/// the web root) and only ever streamed through an access-checked, audited
/// route. Open Point OP-01: a full Aadhaar number is never stored — only its
/// last 4 digits; other ID numbers are stored encrypted.
model IdProof {
  id             String    @id @default(cuid())
  userId         String
  memberId       String
  idType         String // AADHAAR, PAN, VOTER_ID, PASSPORT, DRIVING_LICENCE, OTHER
  idNumberEnc    String?   @db.Text
  idLast4        String
  proofKey       String
  proofMime      String
  selfSignedKey  String
  selfSignedMime String
  status         String    @default("ACTIVE") // ACTIVE, PENDING_CHANGE, SUPERSEDED, REJECTED
  createdAt      DateTime  @default(now())
  supersededAt   DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, status])
  @@map("id_proofs")
}

/// F04–F07. One row per operator per slot per round — the two operators'
/// tasks are separate rows and no operator-facing query ever reads a row
/// that isn't theirs. Reassignment or an Admin reopen adds a new row for the
/// same slot; the latest row per slot is the live one.
model ApprovalTask {
  id              String    @id @default(cuid())
  kind            String // REGISTRATION, PROFILE_CHANGE, ORGANISATION
  subjectUserId   String
  subjectMemberId String
  changeRequestId String?
  /// F26: an organisation registration goes through the same two-operator round.
  organisationId  String?
  round           Int       @default(1)
  slot            Int // 1 or 2
  operatorUserId  String? // null = no eligible operator; Admin must assign
  districtAreaId  String?
  status          String    @default("OPEN") // OPEN, APPROVED, REJECTED, SENT_BACK, ESCALATED, REASSIGNED, CANCELLED
  checklist       Json?
  remarks         String?   @db.Text
  decidedAt       DateTime?
  dueAt           DateTime
  supersededAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subject       User                  @relation("TaskSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  operator      User?                 @relation("TaskOperator", fields: [operatorUserId], references: [id])
  changeRequest ProfileChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)

  @@index([operatorUserId, status])
  @@index([subjectUserId, kind, round])
  @@index([status, dueAt])
  @@map("approval_tasks")
}

/// F08. Sensitive profile fields (name, DOB, gender, ID proof, Mul Gaon)
/// changed by an ACTIVE user wait here; the old values stay live until both
/// operators approve.
model ProfileChangeRequest {
  id        String    @id @default(cuid())
  userId    String
  memberId  String
  changes   Json // { field: { old, new } }
  status    String    @default("PENDING") // PENDING, APPROVED, REJECTED, CANCELLED
  reason    String?   @db.Text
  decidedAt DateTime?
  createdAt DateTime  @default(now())

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks ApprovalTask[]

  @@index([memberId, status])
  @@map("profile_change_requests")
}

/// F16 — handing the Karta role over. VOLUNTARY: the current Karta nominates
/// an adult active member, who must accept (then the existing Admin review
/// applies when ApprovalRule family.karta.change is on). VACANCY: the Karta
/// died; the eldest adult is suggested and an Operator of the family's
/// district (or an Admin) confirms.
model KartaTransfer {
  id                String    @id @default(cuid())
  familyId          String
  kind              String // VOLUNTARY, VACANCY
  fromMemberId      String?
  toMemberId        String?
  suggestedMemberId String?
  status            String    @default("PENDING") // PENDING, ACCEPTED, DECLINED, CONFIRMED, CANCELLED
  requestedBy       String?
  respondedAt       DateTime?
  confirmedBy       String?
  confirmedAt       DateTime?
  slaAlertedAt      DateTime?
  createdAt         DateTime  @default(now())

  @@index([familyId, status])
  @@map("karta_transfers")
}

/// F17 — a registered user says "this is me" about a profile a Karta created
/// earlier; that family's Karta confirms and the two records merge into one.
model ProfileClaim {
  id               String    @id @default(cuid())
  userId           String
  claimantMemberId String // the member created at registration
  targetMemberId   String // the Karta-created, account-less profile
  familyId         String
  status           String    @default("PENDING") // PENDING, CONFIRMED, REJECTED
  decidedBy        String?
  decidedAt        DateTime?
  note             String?
  createdAt        DateTime  @default(now())

  @@index([targetMemberId, status])
  @@index([userId, status])
  @@map("profile_claims")
}

/// F22 — link a person in one family's tree to the same person in another
/// family. On acceptance the two records merge into one person shown in both
/// trees. PLACEHOLDER is a sibling marked "has own family on site" (F21)
/// before the matching person is chosen. Conflicting fields are listed side
/// by side; when the two Kartas disagree it goes to an Operator.
model TreeLinkRequest {
  id                 String    @id @default(cuid())
  fromFamilyId       String
  fromMemberId       String
  toFamilyId         String
  toMemberId         String?
  status             String    @default("PENDING") // PLACEHOLDER, PENDING, OPERATOR_REVIEW, ACCEPTED, REJECTED, CANCELLED
  conflicts          Json?
  proposedResolution Json?
  resolution         Json?
  note               String?   @db.Text
  reason             String?   @db.Text
  requestedBy        String
  decidedBy          String?
  decidedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([toFamilyId, status])
  @@index([fromFamilyId, status])
  @@map("tree_link_requests")
}

/// F26–F31 — a social organisation, or a LadWani body (District > State >
/// National). Each has exactly one President, Secretary and Treasurer plus
/// Members. A body is unique per area (bodyKey). Separate from the existing
/// community groups (mandals), which are left as they are.
model Organisation {
  id                 String    @id @default(cuid())
  kind               String    @default("LOCAL") // LOCAL, DISTRICT_BODY, STATE_BODY, NATIONAL_BODY
  name               String
  registrationNumber String?
  addressLine        String?   @db.Text
  areaId             String? // LOCAL: a taluka (older rows: a district); DISTRICT_BODY: a district; STATE_BODY: a state; NATIONAL_BODY: the country
  startedOn          DateTime? // LOCAL: when the organisation started
  town               String? // LOCAL: city / town name
  purpose            String?   @db.Text
  certificateKey     String? // encrypted file (secure-files)
  certificateMime    String?
  status             String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, CORRECTION_REQUIRED, REJECTED, ACTIVE, INACTIVE
  approvedAt         DateTime?
  decisionNote       String?   @db.Text
  applicantUserId    String?
  bodyKey            String?   @unique // "<kind>:<areaId>" for LadWani bodies
  sourceGroupId      String?   @unique // copied from this community group (P4 follow-up)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([kind, status])
  @@index([areaId])
  @@map("organisations")
}

/// Membership and designation. officeGuard is a STORED generated column (see
/// the migration): the designation while ACTIVE and not MEMBER, so the unique
/// index allows one President / Secretary / Chairman per organisation.
model OrganisationMember {
  id                 String    @id @default(cuid())
  organisationId     String
  memberId           String
  designation        String    @default("MEMBER") // PRESIDENT, SECRETARY, CHAIRMAN, MEMBER
  pendingDesignation String? // F27 handover awaiting the new holder's acceptance
  status             String    @default("ACTIVE") // INVITED, REQUESTED, ACTIVE, DECLINED, ENDED
  termStart          DateTime?
  termEnd            DateTime?
  seatId             String? // body membership that came from automatic promotion (F28–F30)
  invitedBy          String?
  joinedAt           DateTime?
  endedAt            DateTime?
  endReason          String?
  officeGuard        String?   @default(dbgenerated("\nCASE\n    WHEN ((status = 'ACTIVE'::text) AND (designation <> 'MEMBER'::text)) THEN designation\n    ELSE NULL::text\nEND")) // generated; see the comment above the model
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([organisationId, memberId])
  @@unique([organisationId, officeGuard])
  @@index([memberId, status])
  @@map("organisation_members")
}

/// F28–F31 — a seat on the next body up. Each unit's three office bearers
/// hold one automatically while they hold the post (owner's decision).
model BodySeat {
  id                 String    @id @default(cuid())
  fromOrganisationId String
  toOrganisationId   String
  memberId           String
  status             String    @default("NOMINATED") // NOMINATED, ACCEPTED, CONFIRMED, DECLINED, REJECTED, ENDED
  nominatedBy        String
  acceptedAt         DateTime?
  confirmedBy        String?
  confirmedAt        DateTime?
  endedAt            DateTime?
  endReason          String?
  createdAt          DateTime  @default(now())

  @@index([fromOrganisationId, status])
  @@index([toOrganisationId, status])
  @@index([memberId, status])
  @@map("body_seats")
}

/// F35 — a friend request and, once accepted, the friendship (both ways).
model Friendship {
  id                String    @id @default(cuid())
  requesterMemberId String
  addresseeMemberId String
  status            String    @default("PENDING") // PENDING, ACCEPTED, DECLINED, CANCELLED
  respondedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([requesterMemberId, addresseeMemberId])
  @@index([addresseeMemberId, status])
  @@map("friendships")
}

/// F35 — a named list of the owner's friends ("School friends").
model FriendList {
  id            String   @id @default(cuid())
  ownerMemberId String
  name          String
  createdAt     DateTime @default(now())

  @@unique([ownerMemberId, name])
  @@map("friend_lists")
}

model FriendListMember {
  id             String   @id @default(cuid())
  listId         String
  friendMemberId String
  addedAt        DateTime @default(now())

  @@unique([listId, friendMemberId])
  @@index([friendMemberId])
  @@map("friend_list_members")
}

/// F40 — a user's request to delete their account. An Admin processes it:
/// the person is anonymised (the node stays so family trees are not broken),
/// contact data, documents and photos are erased, the login is closed.
model DataDeletionRequest {
  id          String    @id @default(cuid())
  userId      String
  memberId    String?
  reason      String?   @db.Text
  status      String    @default("PENDING") // PENDING, COMPLETED, REJECTED, CANCELLED
  processedBy String?
  processedAt DateTime?
  note        String?   @db.Text
  createdAt   DateTime  @default(now())

  @@index([status, createdAt])
  @@index([userId])
  @@map("data_deletion_requests")
}
