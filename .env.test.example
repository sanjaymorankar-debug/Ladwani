# Test environment for `npm test`. Copy to .env.test (which is gitignored) and
# adjust only if your local server differs:
#
#     cp .env.test.example .env.test
#
# The test suite talks to a REAL MySQL database — every test file imports
# @/lib/prisma and the UAT tests exercise route handlers end to end. It must be
# a database you are willing to have truncated and re-seeded. Never point this
# at the dev database you are working in, and never at Hostinger.

# ── Database ────────────────────────────────────────────────────────────────
# Matches the kesari-devstack local stack: MySQL on 3307, database ladwani_test.
# Change the port if you run MySQL some other way.
DATABASE_URL="mysql://kesari:devstack-local-only@127.0.0.1:3307/ladwani_test"

# ── Test fixtures ───────────────────────────────────────────────────────────
# The suite looks up test.member@example.test, test.karta@example.test,
# test.operator@example.test and friends with findUniqueOrThrow in beforeAll,
# so the seed MUST create them or every test file fails on setup.
#
# prisma/seeds/seed.ts creates them only when this is exactly "true" — the gate
# that keeps the shared published password out of production. Required here.
SEED_TEST_ACCOUNTS=true

ADMIN_EMAIL="admin@example.test"
ADMIN_PASSWORD="test-admin-password"

# ── Auth ────────────────────────────────────────────────────────────────────
# The tests mock next-auth's getServerSession, so no real session is created and
# no real secret is needed. NEXTAUTH_SECRET is kept because src/lib/payments.ts
# falls back to it when PAYMENT_SIGNING_SECRET is unset, and because anything
# that does reach real next-auth would want it.
NEXTAUTH_SECRET="test-only-secret-not-used-for-anything-real"
NEXTAUTH_URL="http://localhost:3000"
# false is the baseline the registration tests expect; verification-mode.test.ts
# stubs it to "true" per-test with vi.stubEnv, so it overrides this itself.
NEXT_PUBLIC_AUTH_REQUIRE_VERIFICATION="false"

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Ladwani (test)"
NEXT_PUBLIC_COMMUNITY_NAME="Ladwani (test)"

# ── Storage ─────────────────────────────────────────────────────────────────
# LOCAL on purpose. The photo tests write real files, and S3 would need a live
# bucket; the local driver needs nothing. Keep UPLOAD_DIR out of the way of the
# dev uploads folder so a test cannot delete something you wanted.
STORAGE_DRIVER="LOCAL"
UPLOAD_DIR="./.tmp/test-uploads"

# ── Payments ────────────────────────────────────────────────────────────────
# MOCK is the only value the code recognises, and the fee tests depend on it:
# /api/payments/[id]/mock-pay refuses to issue credentials when
# activeGateway() !== 'MOCK', so the settle step then gets no signature and
# three tests in tests/uat/assets-fees-posts.test.ts fail inside
# verifySignature. MOCK is also the default, but set it explicitly so nobody
# "configures" it to something real and wonders why payments tests break.
PAYMENT_GATEWAY="MOCK"
PAYMENT_SIGNING_SECRET="test-only-signing-secret"

# ── Mail ────────────────────────────────────────────────────────────────────
# Deliberately unset. src/lib/email.ts treats SMTP as configured only when
# SMTP_HOST, SMTP_USER and SMTP_PASSWORD are all present; short of that it logs
# "[EMAIL:not-configured]" to the console and returns a fake message id. Leaving
# these blank is what stops a test run emailing a real person. Do not fill them
# in for tests.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
